{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoodleDesk",
  "version": "0.1.2",
  "identifier": "app.moodledesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MoodleDesk", "width": 1100, "height": 750 }],
    "security": { "csp": null }
  },
  "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
    "icons/128x128.png",
    "icons/32x32.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ]
}
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["moodledesk"] } }
  }
}
